rules_version = '2';

// All reads/writes to this data go through trusted Next.js server code
// using the Firebase Admin SDK, which bypasses these rules entirely.
// No client (browser) ever talks to Firestore directly in this app, so
// everything is locked down here as defense-in-depth.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
