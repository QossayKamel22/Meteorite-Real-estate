rules_version = '2';

// Most reads/writes still go through trusted Next.js server code using the
// Firebase Admin SDK, which bypasses these rules entirely. These rules are
// the enforcement layer for anything a signed-in browser talks to Firestore
// directly (e.g. real-time favorites/notifications), and defense-in-depth
// for everything else.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Users: everyone can read their own profile; admins can read/manage
    // everyone's. Only the server (Admin SDK) may write role/disabled — a
    // user can never grant themselves admin from the client.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;

      match /favorites/{propertyId} {
        allow read, write: if isSelf(uid);
      }

      match /recentlyViewed/{propertyId} {
        allow read, write: if isSelf(uid);
      }

      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
        allow create: if isAdmin();
        allow delete: if false;
      }
    }

    // Public marketing content — publicly readable, admin-writable. Read is
    // currently served through the Admin SDK on the server, but this makes
    // the collections safe if a client ever reads them directly too.
    match /agents/{agentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    match /stats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Properties: visible ones are public; admins see and manage everything.
    match /properties/{propertyId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    // Media posts (social links + native photo posts): visible ones are
    // public; admins see and manage everything.
    match /mediaPosts/{postId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    // Viewing requests: a signed-in user can create their own and read only
    // their own; only admins can update status or read everyone's.
    match /viewingRequests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Inquiries/leads: same shape as viewing requests.
    match /inquiries/{inquiryId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Admin-only operational data.
    match /activityLog/{entryId} {
      allow read, write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Internal seeding sentinels — server-only.
    match /_meta/{docId} {
      allow read, write: if false;
    }

    // Deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
