{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "meteorite-real-estate",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "meteorite-real-estate"
    }
  ],
  // One KV namespace backs both the page cache and its revalidation tags
  // (key prefixes differ). See open-next.config.ts.
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "0c054b97d6f043c4af41d9c8a26a55b6" },
    { "binding": "NEXT_TAG_CACHE_KV", "id": "0c054b97d6f043c4af41d9c8a26a55b6" }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
