# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Password for the /admin dashboard. Choose a strong, unique value.
ADMIN_PASSWORD=

# Random secret used to sign admin session cookies (32+ random characters).
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# If either of the above is unset, /admin/login will show
# "Admin login is not configured" instead of allowing sign-in.

# --- Firebase ---
# Server-side (Admin SDK) credentials, from a service account key —
# Firebase Console > Project Settings > Service Accounts > Generate new
# private key. Never expose these to the client.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Client-side (public) config — these are safe to expose in the browser
# bundle by design (they identify the project, not secrets). From
# Firebase Console > Project Settings > General > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# One manual step required (cannot be automated): in the Firebase
# Console under Authentication > Sign-in method, enable the "Google"
# provider. Google sign-in will fail with auth/operation-not-allowed
# until this is done.
