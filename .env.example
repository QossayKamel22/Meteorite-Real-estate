# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Password for the /admin dashboard. Choose a strong, unique value.
ADMIN_PASSWORD=

# Random secret used to sign admin session cookies (32+ random characters).
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# If either of the above is unset, /admin/login will show
# "Admin login is not configured" instead of allowing sign-in.
