# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# There is no admin password. Admins sign in through the normal Google
# sign-in on /login, same as everyone else — what makes an account an
# admin is its `role` field in the `users` Firestore collection.
#
# The email below is granted the admin role automatically the first time
# it signs in (this is the only way to bootstrap the very first admin —
# every admin after that is promoted from the Users panel in /admin by an
# existing admin). Leave unset after the first admin exists; it's safe to
# leave set too, since only sign-ins matching this exact address are
# affected.
INITIAL_ADMIN_EMAIL=

# --- Firebase ---
# Service account credentials, from Firebase Console > Project Settings >
# Service Accounts > Generate new private key. Never expose these to the
# client. These are NOT used via the firebase-admin Node SDK (it can't run
# on Cloudflare Workers — no raw TCP/gRPC there) — instead src/lib/
# firestore-rest.ts signs a JWT with this key (via Web Crypto) and exchanges
# it for a Google OAuth2 access token to call the Firestore REST API
# directly, and next-firebase-auth-edge uses the same credentials for
# session verification and admin user management (both edge-compatible).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Two random secrets (32+ bytes each) used to sign the session cookie —
# unrelated to Firebase itself. Generate with: openssl rand -base64 32
# Rotate by moving CURRENT to PREVIOUS and generating a new CURRENT;
# sessions signed with PREVIOUS still verify until they naturally expire.
AUTH_COOKIE_SIGNATURE_KEY_CURRENT=
AUTH_COOKIE_SIGNATURE_KEY_PREVIOUS=

# Client-side (public) config — these are safe to expose in the browser
# bundle by design (they identify the project, not secrets). From
# Firebase Console > Project Settings > General > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# One manual step required (cannot be automated): in the Firebase
# Console under Authentication > Sign-in method, enable the "Google"
# provider. Google sign-in will fail with auth/operation-not-allowed
# until this is done.
